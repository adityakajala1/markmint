NEXT_PUBLIC_API_URL=https://api.markmint.com/api
NEXT_PUBLIC_BASE_URL=https://markmint.com

# Backend Configuration
ENVIRONMENT=production
# PostgreSQL database URL is required in production
# Example: postgresql://user:password@hostname:port/dbname?sslmode=require
DATABASE_URL=

# CORS Origins (Comma separated for multiple, or single string)
# Example: https://app.markmint.com
CORS_ORIGINS=https://your-frontend-domain.com

# Gemini API Key for Vision extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Debug flag (keep false in production)
DEBUG=false
